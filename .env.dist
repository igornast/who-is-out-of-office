# Copy to .env before running docker-compose.prod.yml:
#   cp .env.dist .env
# These are consumed by docker compose interpolation, NOT by Symfony.
# The values here MUST match DATABASE_URL in app/.env.local.

# Pins every bare `docker compose ...` command in this checkout to the production
# stack. Without it, `docker compose up -d` would select the default
# docker-compose.yml — the DEVELOPMENT stack, whose entrypoint drops and recreates
# the database on every start. Keep this line in production.
COMPOSE_FILE=docker-compose.prod.yml

# Interface nginx publishes port 80 on. Defaults to all interfaces (IPv4 and IPv6).
# Recommended: 127.0.0.1 when the TLS-terminating reverse proxy runs on this host,
# so clients cannot bypass the proxy and forge X-Forwarded-* headers.
#HTTP_BIND_ADDRESS=127.0.0.1

MYSQL_DATABASE=ooo_db
MYSQL_USER=ooo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
