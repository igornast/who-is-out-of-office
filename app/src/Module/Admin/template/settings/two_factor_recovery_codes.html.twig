{% extends '@AppAdmin/layout.html.twig' %}

{% block page_title %}{{ 'settings.two_factor.recovery_codes.title'|trans(domain='admin') }}{% endblock %}

{% block content_header %}
    <div class="content-header-title">
        <h1 class="title" style="font-family: var(--font-display); font-size: 22px; font-weight: 600; color: var(--text-primary);">
            {{ 'settings.two_factor.recovery_codes.title'|trans(domain='admin') }}
        </h1>
    </div>
{% endblock %}

{% block main %}
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="settings-card">
                <div class="settings-card-header">
                    <h3 class="settings-card-title">{{ 'settings.two_factor.recovery_codes.save_title'|trans(domain='admin') }}</h3>
                    <p class="settings-card-desc">{{ 'settings.two_factor.recovery_codes.save_desc'|trans(domain='admin') }}</p>
                </div>
                <div class="settings-card-body">
                    <div class="alert alert-warning" style="font-size: 13px; border-radius: var(--radius-md); margin-bottom: 16px;">
                        {{ 'settings.two_factor.recovery_codes.warning'|trans(domain='admin') }}
                    </div>
                    <div style="background: var(--app-surface-sunken); border-radius: var(--radius-md); padding: 20px; font-family: monospace; font-size: 15px; line-height: 2.2; text-align: center; user-select: all; color: var(--text-primary);">
                        {% for code in recoveryCodes %}
                            <div>{{ code }}</div>
                        {% endfor %}
                    </div>
                </div>
                <div class="settings-card-footer">
                    <a href="{{ path('app_settings_account_security') }}" class="btn btn-primary">{{ 'settings.two_factor.recovery_codes.action.done'|trans(domain='admin') }}</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
