<style>
    #calendarCustomizeModal .cc-section { margin-bottom: 1.25rem; }
    #calendarCustomizeModal .cc-sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    #calendarCustomizeModal .cc-sec-head h6 { margin: 0; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-tertiary); font-weight: 700; }
    #calendarCustomizeModal .cc-seg { display: inline-flex; background: var(--app-surface-sunken); border: 1px solid var(--border-light); border-radius: var(--radius-full); padding: 2px; }
    #calendarCustomizeModal .cc-seg button { border: 0; background: none; font-size: 11px; font-weight: 600; padding: 3px 13px; border-radius: var(--radius-full); color: var(--text-tertiary); cursor: pointer; }
    #calendarCustomizeModal .cc-seg button.is-on { background: var(--app-surface); color: var(--primary); box-shadow: var(--shadow-md); }
    #calendarCustomizeModal .cc-auto-note { display: flex; align-items: center; gap: 8px; background: var(--primary-subtle); color: var(--primary-hover); font-size: 11.5px; padding: 8px 11px; border-radius: var(--radius-md); margin-bottom: 8px; }
    #calendarCustomizeModal .cc-row { display: flex; align-items: center; gap: 10px; padding: 6px; border-radius: var(--radius-md); }
    #calendarCustomizeModal .cc-row:hover { background: var(--app-surface-sunken); }
    #calendarCustomizeModal .cc-chev { width: 14px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; background: none; border: 0; padding: 0; color: var(--text-muted); cursor: pointer; }
    #calendarCustomizeModal .cc-chev.is-spacer { visibility: hidden; cursor: default; }
    #calendarCustomizeModal .cc-chev svg { transition: transform .15s ease; }
    #calendarCustomizeModal .cc-chev.is-open svg { transform: rotate(90deg); color: var(--text-secondary); }
    #calendarCustomizeModal .cc-avatar.avatar-img,
    #calendarCustomizeModal .cc-avatar.avatar-placeholder { width: 28px; height: 28px; font-size: 11px; flex: 0 0 auto; }
    #calendarCustomizeModal .cc-row-sm .cc-avatar.avatar-img,
    #calendarCustomizeModal .cc-row-sm .cc-avatar.avatar-placeholder { width: 24px; height: 24px; font-size: 10px; }
    #calendarCustomizeModal .cc-name { flex: 1 1 auto; font-size: 13px; font-weight: 600; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    #calendarCustomizeModal .cc-name small { font-weight: 400; color: var(--text-muted); }
    #calendarCustomizeModal .cc-badge { font-size: 9.5px; padding: 2px 8px; border-radius: var(--radius-full); background: var(--pending-subtle); color: var(--pending); letter-spacing: .04em; text-transform: uppercase; font-weight: 700; border: 1px solid var(--border-light); flex: 0 0 auto; }
    #calendarCustomizeModal .cc-kids { margin: 2px 0 8px 32px; border-left: 2px solid var(--primary-subtle); padding: 6px 0 4px 12px; }
    #calendarCustomizeModal .cc-khint { font-size: 11px; color: var(--text-muted); margin: 0 0 8px 6px; }
    #calendarCustomizeModal .cc-master { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: var(--radius-md); background: var(--primary-subtle); margin-bottom: 4px; cursor: pointer; }
    #calendarCustomizeModal .cc-master .cc-name { font-size: 12.5px; color: var(--primary-hover); white-space: normal; font-weight: 600; }
</style>

<div class="modal fade" id="calendarCustomizeModal" tabindex="-1" aria-labelledby="calendarCustomizeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="calendarCustomizeModalLabel">
                    {{ 'calendar.customize.modal.title'|trans(domain: 'admin') }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">{{ 'calendar.customize.modal.hint'|trans(domain: 'admin') }}</p>

                <div id="calendarCustomizeLoading" class="text-muted small">…</div>
                <div id="calendarCustomizeError" class="alert alert-danger d-none"></div>
                <div id="calendarCustomizeSuccess" class="alert alert-success d-none"></div>

                <div id="calendarCustomizeSections" class="d-none">
                    <section class="cc-section">
                        <div class="cc-sec-head">
                            <h6>{{ 'calendar.customize.section.team'|trans(domain: 'admin') }}</h6>
                            <div class="cc-seg" role="group">
                                <button type="button" data-section="team" data-mode="auto">{{ 'calendar.customize.auto'|trans(domain: 'admin') }}</button>
                                <button type="button" data-section="team" data-mode="custom">{{ 'calendar.customize.custom'|trans(domain: 'admin') }}</button>
                            </div>
                        </div>
                        <div id="calendarCustomizeTeamNote" class="cc-auto-note">
                            {{ 'calendar.customize.team.auto_note'|trans(domain: 'admin') }}
                        </div>
                        <div id="calendarCustomizeTeamList"></div>
                        <p id="calendarCustomizeTeamEmpty" class="text-muted small d-none">
                            {{ 'calendar.customize.team.empty_hint'|trans(domain: 'admin') }}
                        </p>
                    </section>

                    <section class="cc-section">
                        <div class="cc-sec-head">
                            <h6>{{ 'calendar.customize.section.holidays'|trans(domain: 'admin') }}</h6>
                            <div class="cc-seg" role="group">
                                <button type="button" data-section="holidays" data-mode="auto">{{ 'calendar.customize.auto'|trans(domain: 'admin') }}</button>
                                <button type="button" data-section="holidays" data-mode="custom">{{ 'calendar.customize.custom'|trans(domain: 'admin') }}</button>
                            </div>
                        </div>
                        <div id="calendarCustomizeHolidayNote" class="cc-auto-note">
                            {{ 'calendar.customize.holidays.auto_note'|trans(domain: 'admin') }}
                        </div>
                        <div id="calendarCustomizeHolidayList"></div>
                        <p id="calendarCustomizeHolidayEmpty" class="text-muted small d-none">
                            {{ 'calendar.customize.holidays.empty_hint'|trans(domain: 'admin') }}
                        </p>
                    </section>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    {{ 'calendar.customize.action.cancel'|trans(domain: 'admin') }}
                </button>
                <button type="button" class="btn btn-primary" id="calendarCustomizeSaveBtn" disabled>
                    {{ 'calendar.customize.action.save'|trans(domain: 'admin') }}
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    (() => {
        const modal = document.getElementById('calendarCustomizeModal');
        if (!modal) return;

        const getUrl = '{{ path('app_api_calendar_customize_get') }}';
        const postUrl = '{{ path('app_api_calendar_customize_save') }}';
        const csrfPlaceholder = '{{ csrf_token('calendar_customize') }}';
        const staleSuffix = {{ ('calendar.customize.stale_suffix'|trans(domain: 'admin'))|json_encode|raw }};
        const errorText = {{ ('calendar.customize.save_error'|trans(domain: 'admin'))|json_encode|raw }};
        const successText = {{ ('calendar.customize.save_success'|trans(domain: 'admin'))|json_encode|raw }};

        const loading = modal.querySelector('#calendarCustomizeLoading');
        const errorEl = modal.querySelector('#calendarCustomizeError');
        const successEl = modal.querySelector('#calendarCustomizeSuccess');
        const sections = modal.querySelector('#calendarCustomizeSections');
        const teamList = modal.querySelector('#calendarCustomizeTeamList');
        const teamEmpty = modal.querySelector('#calendarCustomizeTeamEmpty');
        const teamNote = modal.querySelector('#calendarCustomizeTeamNote');
        const holidayList = modal.querySelector('#calendarCustomizeHolidayList');
        const holidayEmpty = modal.querySelector('#calendarCustomizeHolidayEmpty');
        const holidayNote = modal.querySelector('#calendarCustomizeHolidayNote');
        const saveBtn = modal.querySelector('#calendarCustomizeSaveBtn');

        const t = {
            managerBadge: {{ ('calendar.customize.manager_badge'|trans(domain: 'admin'))|json_encode|raw }},
            expand: {{ ('calendar.customize.expand_reports'|trans(domain: 'admin'))|json_encode|raw }},
            collapse: {{ ('calendar.customize.collapse_reports'|trans(domain: 'admin'))|json_encode|raw }},
            includeLabel: {{ ('calendar.customize.include_reports_label'|trans(domain: 'admin'))|json_encode|raw }},
            includeHint: {{ ('calendar.customize.include_reports_hint'|trans(domain: 'admin'))|json_encode|raw }},
            personSingular: {{ ('calendar.customize.people_singular'|trans(domain: 'admin'))|json_encode|raw }},
            personPlural: {{ ('calendar.customize.people_plural'|trans(domain: 'admin'))|json_encode|raw }},
            myTeamLabel: {{ ('calendar.customize.my_team_label'|trans(domain: 'admin'))|json_encode|raw }},
        };

        const CHEV = '<svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true">'
            + '<path d="M3 1 L7 5 L3 9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>';

        const state = {
            teamAuto: true,
            holidayAuto: true,
            candidates: { team: [], holidays: [] },
            byId: new Map(),
            topLevelTeamIds: [],
            myTeamIds: [],
            teamSelected: new Set(),
            holidaySelected: new Set(),
            teamStale: [],
            holidayStale: [],
            expanded: new Set(),
            myTeamExpanded: true,
        };

        function firstName(full) { return (full || '').split(' ')[0]; }

        function escapeHtml(s) {
            return (s == null ? '' : String(s))
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function formatTemplate(tpl, vars) {
            return tpl.replace(/%(\w+)%/g, (_, k) => escapeHtml(vars[k] == null ? '' : vars[k]));
        }

        function avatarHtml(candidate) {
            if (candidate.avatarUrl) {
                return '<img class="avatar-img cc-avatar" src="' + escapeHtml(candidate.avatarUrl) + '" alt="">';
            }
            const idx = ((Number(candidate.colorIndex) % 6) + 6) % 6;
            return '<span class="avatar-placeholder cc-avatar avatar-color-' + idx + '">'
                + '<span class="avatar-placeholder-text">' + escapeHtml(candidate.initials) + '</span></span>';
        }

        function teamRowHtml(candidate, asReport) {
            const checked = state.teamSelected.has(candidate.id);
            const inputId = 'cc-team-' + candidate.id;
            // A manager is expandable wherever it appears — even nested inside another
            // team's tray — so a viewer above it (admin / its manager) can opt that
            // sub-team into their own feed. The server only sets isManager/reportIds for
            // candidates the current user actually sits above, so this stays correctly gated.
            const isExpandableManager = candidate.isManager
                && Array.isArray(candidate.reportIds)
                && candidate.reportIds.length > 0;
            const isOpen = state.expanded.has(candidate.id);

            const chevron = isExpandableManager
                ? '<button type="button" class="cc-chev ' + (isOpen ? 'is-open' : '') + '"'
                    + ' data-action="toggle-expand" data-id="' + escapeHtml(candidate.id) + '"'
                    + ' aria-expanded="' + (isOpen ? 'true' : 'false') + '"'
                    + ' aria-label="' + escapeHtml(isOpen ? t.collapse : t.expand) + '">' + CHEV + '</button>'
                : '<span class="cc-chev is-spacer">' + CHEV + '</span>';

            const badge = isExpandableManager ? '<span class="cc-badge">' + escapeHtml(t.managerBadge) + '</span>' : '';

            let html = '<div class="cc-row' + (asReport ? ' cc-row-sm' : '') + '">'
                + chevron
                + '<input type="checkbox" class="form-check-input" id="' + inputId + '" data-action="toggle-member" data-id="' + escapeHtml(candidate.id) + '"' + (checked ? ' checked' : '') + '>'
                + avatarHtml(candidate)
                + '<label for="' + inputId + '" class="cc-name">' + escapeHtml(candidate.name) + ' <small>' + escapeHtml(candidate.email) + '</small></label>'
                + badge
                + '</div>';

            if (isExpandableManager && isOpen) {
                html += managerTrayHtml(candidate);
            }
            return html;
        }

        function managerTrayHtml(manager) {
            const reports = manager.reportIds.map((id) => state.byId.get(id)).filter(Boolean);
            const count = reports.length;
            const peopleWord = count === 1 ? t.personSingular : t.personPlural;
            const hint = formatTemplate(t.includeHint, { name: firstName(manager.name), count: count, people: peopleWord });
            const includeLabel = formatTemplate(t.includeLabel, { name: firstName(manager.name), count: count });
            const allOn = count > 0 && reports.every((r) => state.teamSelected.has(r.id));
            const masterId = 'cc-include-' + manager.id;

            return '<div class="cc-kids">'
                + '<p class="cc-khint">' + hint + '</p>'
                + '<label class="cc-master">'
                +   '<input type="checkbox" class="form-check-input" id="' + masterId + '" data-action="toggle-include-all" data-id="' + escapeHtml(manager.id) + '"' + (allOn ? ' checked' : '') + '>'
                +   '<span class="cc-name">' + includeLabel + '</span>'
                + '</label>'
                + reports.map((r) => teamRowHtml(r, true)).join('')
                + '</div>';
        }

        function myTeamGroupHtml() {
            const reports = state.myTeamIds.map((id) => state.byId.get(id)).filter(Boolean);
            const count = reports.length;
            const label = formatTemplate(t.myTeamLabel, { count: count });
            const allOn = count > 0 && reports.every((r) => state.teamSelected.has(r.id));
            const isOpen = state.myTeamExpanded;

            return '<div class="cc-master cc-myteam-head">'
                + '<button type="button" class="cc-chev ' + (isOpen ? 'is-open' : '') + '"'
                +   ' data-action="toggle-my-team-expand"'
                +   ' aria-expanded="' + (isOpen ? 'true' : 'false') + '"'
                +   ' aria-label="' + escapeHtml(isOpen ? t.collapse : t.expand) + '">' + CHEV + '</button>'
                + '<input type="checkbox" class="form-check-input" id="cc-my-team-all" data-action="toggle-my-team-all"' + (allOn ? ' checked' : '') + '>'
                + '<label for="cc-my-team-all" class="cc-name">' + escapeHtml(label) + '</label>'
                + '</div>'
                + '<div class="cc-kids' + (isOpen ? '' : ' d-none') + '" id="calendarCustomizeMyTeamChildren">'
                +   reports.map((r) => teamRowHtml(r, true)).join('')
                + '</div>';
        }

        function staleRowsHtml(staleIds) {
            return staleIds.map((id) => ''
                + '<div class="cc-row">'
                +   '<span class="cc-chev is-spacer">' + CHEV + '</span>'
                +   '<input type="checkbox" class="form-check-input" checked disabled>'
                +   '<span class="cc-name">' + escapeHtml(id) + ' ' + escapeHtml(staleSuffix) + '</span>'
                + '</div>').join('');
        }

        function reportSelectionState(reportIds) {
            const reports = reportIds.map((id) => state.byId.get(id)).filter(Boolean);
            const selected = reports.filter((r) => state.teamSelected.has(r.id)).length;
            return { total: reports.length, selected: selected };
        }

        function applyIndeterminate() {
            const myTeamMaster = modal.querySelector('#cc-my-team-all');
            if (myTeamMaster) {
                const s = reportSelectionState(state.myTeamIds);
                myTeamMaster.indeterminate = s.selected > 0 && s.selected < s.total;
            }

            state.expanded.forEach((managerId) => {
                const manager = state.byId.get(managerId);
                if (!manager) return;
                const master = modal.querySelector('#cc-include-' + CSS.escape(managerId));
                if (!master) return;
                const s = reportSelectionState(manager.reportIds);
                master.indeterminate = s.selected > 0 && s.selected < s.total;
            });
        }

        function renderTeam() {
            const myTeamSet = new Set(state.myTeamIds);
            const topLevelFlat = state.candidates.team.filter(
                (c) => state.topLevelTeamIds.includes(c.id) && !myTeamSet.has(c.id),
            );

            let html = topLevelFlat.map((c) => teamRowHtml(c, false)).join('');
            if (state.myTeamIds.length > 0) {
                html += myTeamGroupHtml();
            }
            html += staleRowsHtml(state.teamStale);

            teamList.innerHTML = html;
            const isEmpty = 0 === topLevelFlat.length && 0 === state.myTeamIds.length && 0 === state.teamStale.length;
            teamEmpty.classList.toggle('d-none', !isEmpty);
            applyIndeterminate();
        }

        function renderHolidays() {
            const items = state.candidates.holidays;
            holidayList.innerHTML = items.map((h) => {
                const inputId = 'cc-hol-' + h.id;
                const checked = state.holidaySelected.has(h.id);
                return '<div class="cc-row">'
                    + '<input type="checkbox" class="form-check-input" id="' + inputId + '" data-action="toggle-holiday" data-id="' + escapeHtml(h.id) + '"' + (checked ? ' checked' : '') + '>'
                    + '<label for="' + inputId + '" class="cc-name">' + escapeHtml(h.countryName) + ' <small>' + escapeHtml(h.countryCode) + '</small></label>'
                    + '</div>';
            }).join('') + staleRowsHtml(state.holidayStale);

            const isEmpty = 0 === items.length && 0 === state.holidayStale.length;
            holidayEmpty.classList.toggle('d-none', !isEmpty);
        }

        function renderSegments() {
            modal.querySelectorAll('.cc-seg button').forEach((btn) => {
                const auto = 'team' === btn.dataset.section ? state.teamAuto : state.holidayAuto;
                const wantOn = ('auto' === btn.dataset.mode) === auto;
                btn.classList.toggle('is-on', wantOn);
            });
            teamNote.style.display = state.teamAuto ? '' : 'none';
            holidayNote.style.display = state.holidayAuto ? '' : 'none';
        }

        function render() {
            sections.classList.remove('d-none');
            loading.classList.add('d-none');
            saveBtn.disabled = false;
            renderSegments();
            renderTeam();
            renderHolidays();
        }

        function setTeamMember(id, on) {
            if (on) state.teamSelected.add(id); else state.teamSelected.delete(id);
        }

        function defaultTeamSelection() { return new Set(state.topLevelTeamIds); }
        function defaultHolidaySelection() { return new Set(state.candidates.holidays.map((h) => h.id)); }

        teamList.addEventListener('click', (evt) => {
            const expandBtn = evt.target instanceof Element ? evt.target.closest('[data-action="toggle-expand"]') : null;
            if (expandBtn) {
                const id = expandBtn.dataset.id;
                if (state.expanded.has(id)) state.expanded.delete(id); else state.expanded.add(id);
                renderTeam();
                return;
            }
            const myTeamBtn = evt.target instanceof Element ? evt.target.closest('[data-action="toggle-my-team-expand"]') : null;
            if (myTeamBtn) {
                state.myTeamExpanded = !state.myTeamExpanded;
                renderTeam();
            }
        });

        teamList.addEventListener('change', (evt) => {
            const cb = evt.target;
            if (!(cb instanceof HTMLInputElement) || 'checkbox' !== cb.type) return;
            const action = cb.dataset.action;

            if ('toggle-member' === action) {
                setTeamMember(cb.dataset.id, cb.checked);
                state.teamAuto = false;
            } else if ('toggle-include-all' === action) {
                const mgr = state.byId.get(cb.dataset.id);
                if (mgr) mgr.reportIds.forEach((rid) => setTeamMember(rid, cb.checked));
                state.teamAuto = false;
            } else if ('toggle-my-team-all' === action) {
                state.myTeamIds.forEach((rid) => setTeamMember(rid, cb.checked));
                state.teamAuto = false;
            } else {
                return;
            }

            renderSegments();
            renderTeam();
        });

        holidayList.addEventListener('change', (evt) => {
            const cb = evt.target;
            if (!(cb instanceof HTMLInputElement) || 'toggle-holiday' !== cb.dataset.action) return;
            if (cb.checked) state.holidaySelected.add(cb.dataset.id); else state.holidaySelected.delete(cb.dataset.id);
            state.holidayAuto = false;
            renderSegments();
        });

        modal.querySelectorAll('.cc-seg button').forEach((btn) => {
            btn.addEventListener('click', () => {
                const toAuto = 'auto' === btn.dataset.mode;
                if ('team' === btn.dataset.section) {
                    state.teamAuto = toAuto;
                    if (toAuto) {
                        state.teamSelected = defaultTeamSelection();
                        state.expanded = new Set();
                        state.myTeamExpanded = true;
                    }
                    renderSegments();
                    renderTeam();
                } else {
                    state.holidayAuto = toAuto;
                    if (toAuto) state.holidaySelected = defaultHolidaySelection();
                    renderSegments();
                    renderHolidays();
                }
            });
        });

        async function load() {
            loading.classList.remove('d-none');
            sections.classList.add('d-none');
            errorEl.classList.add('d-none');
            successEl.classList.add('d-none');
            saveBtn.disabled = true;

            try {
                const res = await fetch(getUrl, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                if (!res.ok) throw new Error('load failed');
                const data = await res.json();

                state.candidates.team = data.candidateTeamMembers || [];
                state.candidates.holidays = data.candidateHolidayCalendars || [];
                state.topLevelTeamIds = data.topLevelTeamMemberIds || [];
                state.myTeamIds = data.myTeamMemberIds || [];
                state.byId = new Map(state.candidates.team.map((c) => [c.id, c]));
                state.expanded = new Set();
                state.myTeamExpanded = true;

                const teamKnown = new Set(state.candidates.team.map((c) => c.id));
                if (null === data.selectedTeamMemberIds) {
                    state.teamAuto = true;
                    state.teamSelected = defaultTeamSelection();
                    state.teamStale = [];
                } else {
                    state.teamAuto = false;
                    state.teamSelected = new Set((data.selectedTeamMemberIds || []).filter((id) => teamKnown.has(id)));
                    state.teamStale = (data.selectedTeamMemberIds || []).filter((id) => !teamKnown.has(id));
                }

                const holKnown = new Set(state.candidates.holidays.map((h) => h.id));
                if (null === data.selectedHolidayCalendarIds) {
                    state.holidayAuto = true;
                    state.holidaySelected = defaultHolidaySelection();
                    state.holidayStale = [];
                } else {
                    state.holidayAuto = false;
                    state.holidaySelected = new Set((data.selectedHolidayCalendarIds || []).filter((id) => holKnown.has(id)));
                    state.holidayStale = (data.selectedHolidayCalendarIds || []).filter((id) => !holKnown.has(id));
                }

                render();
            } catch (e) {
                loading.classList.add('d-none');
                errorEl.classList.remove('d-none');
                errorEl.textContent = errorText;
            }
        }

        saveBtn.addEventListener('click', async () => {
            saveBtn.disabled = true;
            errorEl.classList.add('d-none');

            const payload = {
                _token: window.AppCsrf.rotateStatelessCsrfToken(csrfPlaceholder),
                teamMemberIds: [...state.teamSelected, ...state.teamStale],
                holidayCalendarIds: [...state.holidaySelected, ...state.holidayStale],
                teamMemberIdsAuto: state.teamAuto,
                holidayCalendarIdsAuto: state.holidayAuto,
            };

            try {
                const res = await fetch(postUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                if (!res.ok) throw new Error('save failed');
                successEl.textContent = successText;
                successEl.classList.remove('d-none');
                window.setTimeout(() => {
                    successEl.classList.add('d-none');
                    const inst = bootstrap.Modal.getInstance(modal);
                    if (inst) inst.hide();
                }, 900);
            } catch (e) {
                errorEl.classList.remove('d-none');
                errorEl.textContent = errorText;
                saveBtn.disabled = false;
            }
        });

        modal.addEventListener('show.bs.modal', load);
    })();
</script>
