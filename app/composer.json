{
    "name": "igornast/who-is-out-of-office",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "igor.nastarowicz",
            "email": "nastarowicz@hotmail.com"
        }
    ],
    "homepage": "https://www.whoisooo.app",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.5.0",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7.2",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "^4.29.16",
        "eluceo/ical": "^2.17",
        "endroid/qr-code": "^6.1.3",
        "guzzlehttp/psr7": "^2.13.1",
        "illuminate/collections": "^12.69.2",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.6",
        "ramsey/uuid": "^4.9.4",
        "ramsey/uuid-doctrine": "^2.1",
        "scheb/2fa-backup-code": "^8.6.1",
        "scheb/2fa-bundle": "^8.6.1",
        "scheb/2fa-totp": "^8.6.1",
        "sentry/sentry-symfony": "^5.13.0",
        "symfony/asset": "^7.4.8",
        "symfony/asset-mapper": "^7.4.19",
        "symfony/console": "^7.4.19",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "^7.4.18",
        "symfony/expression-language": "^7.4.18",
        "symfony/flex": "^2.11.0",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/notifier": "7.4.*",
        "symfony/password-hasher": "^7.4.8",
        "symfony/property-access": "^7.4.16",
        "symfony/property-info": "^7.4.19",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "^7.4.14",
        "symfony/scheduler": "7.4.*",
        "symfony/serializer": "^7.4.19",
        "symfony/slack-notifier": "^7.4.4",
        "symfony/stimulus-bundle": ">=3.5.1",
        "symfony/twig-bundle": "^7.4.19",
        "symfony/ux-live-component": ">=3.5.1",
        "symfony/yaml": "7.4.*",
        "tattali/calendar-bundle": "^7.0.2",
        "twig/extra-bundle": "^3.29",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.4.1",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "mockery/mockery": "^1.6.15",
        "nelmio/alice": "^3.17.0",
        "pestphp/pest": "^3.8.7",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^11.5.56",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/panther": "^2.4",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:phpunit:u": "./vendor/bin/pest --testsuite Unit --coverage --compact",
        "test:phpunit:f": "./vendor/bin/pest --testsuite Functional --display-warnings --display-errors",
        "test:arch": "./vendor/bin/pest tests/Architecture --compact",
        "test:cs": "./vendor/bin/php-cs-fixer fix --dry-run --diff -v",
        "test:cs:fix": "./vendor/bin/php-cs-fixer fix --diff -v",
        "test:stan": "./vendor/bin/phpstan analyse -c phpstan.neon",
        "test": [
            "@test:cs",
            "@test:stan",
            "@test:arch",
            "@test:phpunit:u",
            "@reset-test-db",
            "@test:phpunit:f"
        ],
        "test-ci": [
            "@test:cs",
            "@test:stan",
            "@test:arch",
            "@reset-test-db",
            "./vendor/bin/pest --testsuite Unit,Functional --coverage --coverage-clover clover.xml --display-errors"
        ],
        "reset-test-db": [
            "php bin/console doctrine:database:drop --if-exists --force --env=test",
            "php bin/console doctrine:database:create --env=test",
            "php bin/console doctrine:schema:update --force --env=test",
            "php bin/console doctrine:fixtures:load --no-interaction --env=test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
